// ============================================================================
// CONFIGURATOR / OFFERTE BUILDER (Builder Layer)
// ============================================================================

/// A configurator is a multi-step wizard that lets end-users configure a service
/// or product, get a live price calculation, and submit as a lead/quote request.
/// Think: offerte-builder, product configurator, price calculator.
model Configurator {
  id          String @id @default(cuid())
  workspaceId String

  name        String              // Internal name: "Website Offerte Wizard"
  slug        String              // Public URL: /configure/[slug]
  description String?
  status      ConfiguratorStatus  @default(DRAFT)

  // Versioning — only one version is "live" at a time
  activeVersionId String?         // Currently published version
  versions        ConfiguratorVersion[]

  // Branding overrides (null = inherit workspace brand)
  brandColor       String?
  brandLogoUrl     String?
  backgroundColor  String?
  accentColor      String?
  fontFamily       String?

  // Settings
  settings Json @default("{}") // submitAction, redirectUrl, emailNotify, etc.

  // Public access
  isPublic    Boolean @default(false)
  publicToken String  @unique @default(cuid())

  // Embed settings
  embedSettings EmbedSettings?

  // Submissions
  submissions ConfiguratorSubmission[]

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@map("configurators")
}

/// A version snapshot of a configurator. Allows editing without breaking live version.
model ConfiguratorVersion {
  id              String @id @default(cuid())
  configuratorId  String
  versionNumber   Int    @default(1)
  label           String? // "v1.0", "Zomer campagne"

  // The full step/block schema for this version
  steps ConfiguratorStep[]

  // Pricing rules for this version
  pricingRules PricingRule[]

  // Metadata
  publishedAt DateTime?
  isArchived  Boolean   @default(false)

  configurator Configurator @relation(fields: [configuratorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([configuratorId, versionNumber])
  @@map("configurator_versions")
}

/// A step (page/screen) in the configurator wizard.
/// Steps are ordered and can have conditional visibility.
model ConfiguratorStep {
  id        String @id @default(cuid())
  versionId String

  title       String
  description String?
  position    Int     @default(0)
  icon        String? // Lucide icon name

  // Conditional visibility: JSON logic expression
  // e.g. { "==": [{ "var": "projectType" }, "website"] }
  condition Json?

  blocks ConfiguratorBlock[]

  version ConfiguratorVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, position])
  @@map("configurator_steps")
}

/// A block is a single form element within a step.
/// Schema-driven: the blockType + config determine rendering.
model ConfiguratorBlock {
  id     String @id @default(cuid())
  stepId String

  // Block type determines the renderer
  blockType ConfiguratorBlockType
  fieldKey  String  // Unique key for this field: "projectType", "pageCount", etc.
  label     String
  helpText  String?
  position  Int     @default(0)

  // Type-specific configuration as JSON
  // For SELECT: { options: [{ label: "Website", value: "website", icon: "Globe" }] }
  // For SLIDER: { min: 1, max: 50, step: 1, unit: "pagina's" }
  // For CHECKBOX_GROUP: { options: [...], minSelect: 1, maxSelect: 5 }
  config Json @default("{}")

  // Validation rules
  isRequired  Boolean @default(false)
  validation  Json?   // { min: 1, max: 100, pattern: "..." }

  // Conditional visibility
  condition Json?

  // Pricing impact reference (which PricingRule keys this affects)
  pricingKeys String[] // ["basePrice", "pageMultiplier"]

  step ConfiguratorStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, position])
  @@map("configurator_blocks")
}

/// A pricing rule defines how selections affect the total price.
/// Rules are evaluated in order; supports fixed, multiplier, conditional, tiered.
model PricingRule {
  id        String @id @default(cuid())
  versionId String

  key         String         // Unique identifier: "basePrice", "seoAddon"
  label       String         // Display label in breakdown
  ruleType    PricingRuleType
  position    Int            @default(0)

  // Rule configuration (depends on ruleType)
  // FIXED:        { amount: 500 }
  // PER_UNIT:     { amountPerUnit: 150, fieldKey: "pageCount" }
  // MULTIPLIER:   { factor: 1.5, condition: { "==": [{"var":"urgency"}, "express"] } }
  // TIERED:       { tiers: [{ min: 1, max: 5, price: 100 }, { min: 6, max: 20, price: 80 }], fieldKey: "pageCount" }
  // CONDITIONAL:  { amount: 300, condition: { "in": ["seo", {"var":"addons"}] } }
  // PERCENTAGE:   { percentage: 21, of: "subtotal", label: "BTW 21%" }
  config Json

  // Whether this rule is always active or conditional
  isOptional Boolean @default(false)

  version ConfiguratorVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, position])
  @@map("pricing_rules")
}

/// A submission from a public configurator page.
/// Contains all selected values, calculated price, and contact info.
model ConfiguratorSubmission {
  id              String @id @default(cuid())
  configuratorId  String

  // Snapshot of all user selections
  selections Json  // { projectType: "website", pageCount: 12, addons: ["seo","analytics"] }

  // Calculated pricing breakdown
  pricingBreakdown Json  // [{ key: "basePrice", label: "Basis", amount: 500 }, ...]
  subtotal         Decimal @db.Decimal(12, 2)
  taxAmount        Decimal @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)

  // Contact info from final step
  contactName    String
  contactEmail   String
  contactPhone   String?
  contactCompany String?
  contactNotes   String?

  // CRM integration: auto-created entities
  contactId String?
  leadId    String?
  quoteId   String?

  // Status
  status ConfiguratorSubmissionStatus @default(NEW)

  // Source tracking
  source    String? // "hosted", "embed-iframe", "embed-js"
  referrer  String?
  utmSource String?

  configurator Configurator @relation(fields: [configuratorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([configuratorId, createdAt])
  @@index([configuratorId, status])
  @@map("configurator_submissions")
}

// ============================================================================
// EMBED SETTINGS (Distribution Layer)
// ============================================================================

/// Embed configuration for a configurator or booking page.
/// Controls how the widget appears when embedded on external sites.
model EmbedSettings {
  id              String @id @default(cuid())
  configuratorId  String? @unique
  bookingTypeId   String?

  // Embed mode
  embedType  EmbedType @default(IFRAME)

  // Appearance
  width      String  @default("100%")
  height     String  @default("700px")
  borderRadius String @default("12px")
  shadow     Boolean @default(true)

  // Behavior
  autoResize  Boolean @default(true)
  hideHeader  Boolean @default(false)
  hideFooter  Boolean @default(false)

  // Domain restrictions (empty = allow all)
  allowedDomains String[] // ["example.com", "*.example.com"]

  // Custom CSS injection
  customCss String?

  // Generated embed codes (read-only, computed)
  iframeCode  String?
  jsSnippet   String?
  hostedUrl   String?

  configurator Configurator? @relation(fields: [configuratorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("embed_settings")
}

// ============================================================================
// BOOKING PAGE (Builder Layer extension)
// ============================================================================

/// Extended booking page settings for the builder layer.
/// Adds branding, embed, and customization on top of BookingType.
model BookingPage {
  id            String @id @default(cuid())
  bookingTypeId String @unique
  workspaceId   String

  // Custom branding (null = inherit workspace)
  brandColor      String?
  brandLogoUrl    String?
  backgroundColor String?
  headerText      String?
  confirmationText String?

  // Embed settings
  embedType       EmbedType @default(IFRAME)
  allowedDomains  String[]
  autoResize      Boolean   @default(true)
  customCss       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("booking_pages")
}

// ============================================================================
// NEW ENUMS
// ============================================================================

enum ConfiguratorStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConfiguratorBlockType {
  // Selection types
  SELECT_CARDS    // Visual card selection (single)
  SELECT_DROPDOWN // Standard dropdown
  RADIO_GROUP     // Radio buttons
  CHECKBOX_GROUP  // Multi-select checkboxes
  TOGGLE          // On/off toggle

  // Input types
  TEXT_INPUT      // Single line text
  TEXTAREA        // Multi-line text
  NUMBER_INPUT    // Numeric input
  SLIDER          // Range slider with live value
  DATE_PICKER     // Date selection

  // Layout types
  HEADING         // Section heading / info text
  DIVIDER         // Visual separator
  IMAGE           // Decorative / info image
  PRICE_PREVIEW   // Live price breakdown display

  // Contact (final step)
  CONTACT_FORM    // Name, email, phone, company, notes
}

enum PricingRuleType {
  FIXED         // Fixed amount added when condition met
  PER_UNIT      // Amount × quantity from a field
  MULTIPLIER    // Multiply subtotal by factor
  TIERED        // Tiered pricing based on quantity
  CONDITIONAL   // Add amount when condition matches
  PERCENTAGE    // Percentage of subtotal (e.g., tax)
  DISCOUNT      // Subtract amount or percentage
}

enum ConfiguratorSubmissionStatus {
  NEW
  CONTACTED
  CONVERTED
  ARCHIVED
}

enum EmbedType {
  IFRAME    // Standard iframe embed
  JS_WIDGET // JavaScript snippet (shadow DOM)
  POPUP     // Click-to-open modal
}
