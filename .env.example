# Local development (docker compose up -d)
DATABASE_URL="postgresql://digitify:digitify_dev@localhost:5432/digitify_leads?schema=public"
DIRECT_URL="postgresql://digitify:digitify_dev@localhost:5432/digitify_leads?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate unique local values with: openssl rand -base64 48
NEXTAUTH_SECRET="replace-with-a-random-string-at-least-32-characters"

# Optional: comma-separated OWNER emails allowed to manage accounts platform-wide.
# Keep this list short; workspace OWNERs remain workspace-scoped by default.
PLATFORM_OWNER_EMAILS=""
SETTINGS_ENCRYPTION_KEY="replace-with-a-different-random-string-at-least-32-characters"
CRON_SECRET="replace-with-a-random-string-at-least-16-characters"

# Local Redis is optional. Without it, rate limiting uses an in-memory fallback.
REDIS_URL="redis://localhost:6379"

# Required in production. Keep false locally until the RLS smoke test is part of
# the local workflow; production startup rejects any value other than true.
ENABLE_WORKSPACE_RLS="false"

# Optional observability and storage
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# BLOB_READ_WRITE_TOKEN=""

# Optional provider integrations. Configure these through the app where possible.
# GOOGLE_ADS_DEVELOPER_TOKEN=""
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# DEEPSEEK_API_KEY=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Explicit credentials are required only when running pnpm db:seed.
# SEED_ADMIN_EMAIL="admin@digitify.local"
# SEED_ADMIN_PASSWORD="use-a-local-password-of-at-least-12-characters"
