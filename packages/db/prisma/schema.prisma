  id          String   @id @default(cuid())
  slideId     String
  targetSlideId String
  label       String?
  x           Float
  y           Float
  width       Float
  height      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slide       PresentationSlide @relation("SlideHotspots", fields: [slideId], references: [id], onDelete: Cascade)
  targetSlide PresentationSlide @relation("TargetHotspots", fields: [targetSlideId], references: [id], onDelete: Cascade)

  @@index([slideId])
  @@index([targetSlideId])
  @@map("presentation_hotspots")
}

model PresentationShare {
  id             String   @id @default(cuid())
  presentationId String
  tokenHash      String   @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  lastOpenedAt   DateTime?
  presentation  Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@index([presentationId, revokedAt])
  @@map("presentation_shares")
}
