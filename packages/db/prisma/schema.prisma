enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
}

enum MetaAdPlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUSHING
  PUSHED_PAUSED
  FAILED
  CANCELLED
}

enum GoogleAdPlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUSHING
  PUSHED_PAUSED
  FAILED
  CANCELLED
}

enum GoogleAdCampaignType {
  SEARCH
  PERFORMANCE_MAX
}

model SocialPost {
  id              String           @id @default(cuid())
  createdById     String
  approvedById    String?
  caption         String           @db.Text
  imageUrl        String
  scheduledFor    DateTime?
  status          SocialPostStatus @default(DRAFT)
  targetPlatforms SocialPlatform[]
  metadata        Json?
  externalPostIds Json?
  approvedAt      DateTime?
  publishedAt     DateTime?
  retryCount      Int              @default(0)
  lastError       String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy User  @relation("SocialPostCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy User? @relation("SocialPostApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([createdById, status])
  @@index([status, scheduledFor])
  @@index([createdById, updatedAt(sort: Desc)])
  @@map("social_posts")
}

model MetaAdAccount {
  id                String    @id @default(cuid())
  createdById       String
  externalAccountId String
  name              String
  currency          String?   @default("EUR")
  timezoneName      String?
  businessId        String?
  isSelected        Boolean   @default(false)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy User @relation("MetaAdAccountCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([createdById, externalAccountId])
  @@index([createdById, isSelected])
  @@map("meta_ad_accounts")
}

model MetaAdPlan {
  id                  String           @id @default(cuid())
  createdById         String
  approvedById        String?
  name                String
  objective           String           @default("OUTCOME_TRAFFIC")
  status              MetaAdPlanStatus @default(DRAFT)
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  currency            String           @default("EUR")
  startTime           DateTime?
  endTime             DateTime?
  targeting           Json?
  creatives           Json?
  externalIds         Json?
  approvedAt          DateTime?
  pushedAt            DateTime?
  retryCount          Int              @default(0)
  lastError           String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  createdBy  User  @relation("MetaAdPlanCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy User? @relation("MetaAdPlanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([createdById, status])
  @@index([createdById, updatedAt(sort: Desc)])
  @@map("meta_ad_plans")
}

// Unified advertising workflow. createdById is always the workspace owner id.
model AdBackgroundJob {
  id String @id @default(cuid())
  createdById String
  provider String
  kind String
  dedupeKey String @unique
  dependencyId String?
  status String @default("PENDING")
  attempts Int @default(0)
  runAt DateTime @default(now())
  leaseToken String?
  leasedUntil DateTime?
  result Json?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([createdById, provider, status, runAt])
  @@map("ad_background_jobs")
}

model AdVersion {
  id          String   @id @default(cuid())
  createdById String
  provider    String
  accountId   String
  campaignId  String
  fingerprint String
  snapshot    Json
  metrics     Json?
  syncedAt    DateTime @default(now())
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changes     AdChangeSet[]
  @@index([createdById, provider, campaignId, syncedAt])
  @@map("ad_versions")
}

model AdChangeSet {
  id          String   @id @default(cuid())
  createdById String
  authorId    String
  provider    String
  accountId   String
  campaignId  String
  baseVersionId String
  beforeHash  String
  afterHash   String
  before      Json
  after       Json
  reason      String
  source      String   @default("MANUAL")
  researchRunId String?
  confidence  Float?
  evidenceRefs Json?
  risk        String   @default("MEDIUM")
  checks      Json
  status      String   @default("PENDING_APPROVAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User @relation("AdChangeWorkspace", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author      User @relation("AdChangeAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  baseVersion AdVersion @relation(fields: [baseVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  researchRun AdResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  approval    AdApprovalRequest?
  operation   AdSyncOperation?
  @@index([createdById, provider, status])
  @@map("ad_change_sets")
}

model AdResearchRun {
  id              String   @id @default(cuid())
  createdById     String
  provider        String
  sourceMode      String   @default("ACCOUNT_DATA")
  status          String   @default("PENDING")
  objective       String?
  campaignIds     Json?
  input           Json
  profileHash     String?
  profileVersion  Int?
  promptVersion   String
  model           String?
  result          Json?
  attempts        Int      @default(0)
  leaseToken      String?
  leasedUntil     DateTime?
  idempotencyKey  String
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?

  createdBy User @relation("AdResearchRunCreatedBy", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evidence AdResearchEvidence[]
  changes AdChangeSet[]

  @@index([createdById, status, createdAt(sort: Desc)])
  @@index([createdById, provider, createdAt(sort: Desc)])
  @@unique([createdById, idempotencyKey])
  @@map("ad_research_runs")
}

model AdResearchEvidence {
  id           String   @id @default(cuid())
  createdById  String
  researchRunId String
  kind         String
  title        String?
  url          String?
  excerpt      String?  @db.Text
  digest       String?
  metadata     Json?
  fetchedAt    DateTime @default(now())

  createdBy User @relation("AdResearchEvidenceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  researchRun AdResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdById, researchRunId, fetchedAt(sort: Desc)])
  @@index([createdById, kind, fetchedAt(sort: Desc)])
  @@map("ad_research_evidence")
}

model AdApprovalRequest {
  id          String   @id @default(cuid())
  createdById String
  changeSetId String   @unique
  versionHash String
  status      String   @default("PENDING")
  decidedById String?
  decidedAt   DateTime?
  reason      String?
  remindedAt  DateTime?
  createdAt   DateTime @default(now())
  createdBy   User @relation("AdApprovalWorkspace", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  decidedBy   User? @relation("AdApprovalActor", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  change      AdChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([createdById, status])
  @@map("ad_approval_requests")
}

model AdSyncOperation {
  id          String   @id @default(cuid())
  createdById String
  provider    String
  changeSetId String   @unique
  idempotencyKey String @unique
  resourceKey String? @unique
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  response    Json?
  errorCode   String?
  lastError   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  change      AdChangeSet @relation(fields: [changeSetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([createdById, status])
  @@map("ad_sync_operations")
}

model AiOptimizationRun {
  id          String   @id @default(cuid())
  runKey      String?  @unique
  createdById String
  provider    String
  periodStart DateTime
  periodEnd   DateTime
  promptVersion String
  status      String   @default("RUNNING")
  model       String?
  input       Json
  result      Json?
  lastError   String?
  createdAt   DateTime @default(now())
  finishedAt  DateTime?
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([createdById, provider, createdAt])
  @@map("ai_optimization_runs")
}

model GoogleAdAccount {
  id                 String    @id @default(cuid())
  createdById        String
  externalCustomerId String
  name               String
  currency           String?   @default("EUR")
  timezoneName       String?
  isSelected         Boolean   @default(false)
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy User @relation("GoogleAdAccountCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([createdById, externalCustomerId])
  @@index([createdById, isSelected])
  @@map("google_ad_accounts")
}

model GoogleAdPlan {
  id                  String               @id @default(cuid())
  createdById         String
  approvedById        String?
  name                String
  campaignType        GoogleAdCampaignType @default(SEARCH)
  status              GoogleAdPlanStatus   @default(DRAFT)
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  currency            String               @default("EUR")
  startTime           DateTime?
  endTime             DateTime?
  targeting           Json?
  creatives           Json?
  externalIds         Json?
  approvedAt          DateTime?
  pushedAt            DateTime?
  retryCount          Int                  @default(0)
  lastError           String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  createdBy  User  @relation("GoogleAdPlanCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy User? @relation("GoogleAdPlanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([createdById, status])
  @@index([createdById, updatedAt(sort: Desc)])
  @@map("google_ad_plans")
}

// ENRICHMENT DATA
model EnrichmentData {
  id        String   @id @default(cuid())
  leadId    String
  source    String
  data      Json
  fetchedAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, source])
  @@map("enrichment_data")
}

// OPENCLAW (AI)
model OpenClawSuggestion {
  id          String                  @id @default(cuid())
  leadId      String?
  type        OpenClawSuggestionType
  title       String
  content     String                  @db.Text
  confidence  Float?
  status      SuggestionStatus        @default(PENDING)
  metadata    Json?
  createdAt   DateTime                @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@map("openclaw_suggestions")
}

model LeadAnalysisRun {
  id              String             @id @default(cuid())
  workspaceId     String
  leadId          String
  createdById     String
