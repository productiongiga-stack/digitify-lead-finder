generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// AUTH & USERS
model UserTwoFactor {
  userId String @id
  secret String?
  enabledAt DateTime?
  lastUsedStep BigInt @default(-1)
  pendingSecret String?
  pendingExpiresAt DateTime?
  pendingVersion Int?
  pendingCodeHashes Json?
  pendingProofHash String?
  pendingStep BigInt?
  failures Int @default(0)
  failureWindowAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@map("user_two_factors")
}

model TwoFactorRecoveryCode {
  id String @id @default(cuid())
  userId String
  codeHash String
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([userId, codeHash])
  @@map("two_factor_recovery_codes")
}

model LoginChallenge {
  id String @id @default(cuid())
  purpose String @default("LOGIN")
  tokenHash String @unique
  userId String
  sessionVersion Int
  requiresTwoFactor Boolean
  expiresAt DateTime
  attempts Int @default(0)
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([userId, expiresAt])
  @@map("login_challenges")
}

model TwoFactorRecoveryGrant {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  sessionVersion Int
  expiresAt DateTime
  usedAt DateTime?
  operatorId String
  ticket String
  reason String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@map("two_factor_recovery_grants")
}

model AuthRateBucket {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  @@map("auth_rate_buckets")
}
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String?
  sessionVersion Int       @default(0)
  twoFactorEnabled Boolean @default(false)
  twoFactorRecoveryRequired Boolean @default(false)
  twoFactor UserTwoFactor?
  twoFactorCodes TwoFactorRecoveryCode[]
  loginChallenges LoginChallenge[]
  factorRecoveries TwoFactorRecoveryGrant[]
  image          String?
  emailVerified  DateTime?
  role           UserRole  @default(MEMBER)
  accountClass   AccountClass @default(CLIENT_OWNER)
  accountStatus  AccountStatus @default(ACTIVE)
  platformRole   PlatformRole?
  trialEndsAt    DateTime?
  workspaceOwnerId String?
  activeWorkspaceId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspaceOwner   User?  @relation("WorkspaceMembers", fields: [workspaceOwnerId], references: [id], onDelete: SetNull)
  workspaceMembers User[] @relation("WorkspaceMembers")
  ownedWorkspaces  Workspace[] @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMembership[] @relation("WorkspaceMembershipUser")
  sentWorkspaceInvites WorkspaceMembership[] @relation("WorkspaceMembershipInviter")

  accounts       Account[]
  sessions       Session[]
  leads          Lead[]           @relation("CreatedByUser")
  savedLeads     Lead[]           @relation("LeadSavedBy")
  editedLeads    Lead[]           @relation("LeadLastEditedBy")
  assignedLeads  Lead[]           @relation("AssignedToUser")
  notes          Note[]
  activities     Activity[]
  emailDrafts    EmailDraft[]     @relation("DraftAuthor")
  emailApprovals EmailDraft[]     @relation("DraftApprover")
  campaigns      Campaign[]
  reports        Report[]
  openclawLogs   OpenClawLog[]
  permissions    UserPermission[]
  bookings       Booking[]
  hostedBookings Booking[] @relation("BookingHost")
  bookingEventTypes BookingEventType[]
  domains        Domain[]
  reviewRequests ReviewRequest[]
  quotes       Quote[]
  chatAssignments ChatSession[] @relation("ChatAssignee")
  reviewedRegistrationRequests RegistrationRequest[] @relation("RegistrationReviewer")
  reviewedFeedbackItems FeedbackItem[] @relation("FeedbackReviewer")
  workspaceTasks       WorkspaceTask[]
  workspaceInvoices    WorkspaceInvoice[]
  workspaceSavedSearches WorkspaceSavedSearch[]
  socialPosts          SocialPost[]      @relation("SocialPostCreatedBy")
  approvedSocialPosts  SocialPost[]      @relation("SocialPostApprovedBy")
  metaAdAccounts       MetaAdAccount[]   @relation("MetaAdAccountCreatedBy")
  metaAdPlans          MetaAdPlan[]      @relation("MetaAdPlanCreatedBy")
  approvedMetaAdPlans  MetaAdPlan[]      @relation("MetaAdPlanApprovedBy")
  googleAdAccounts     GoogleAdAccount[] @relation("GoogleAdAccountCreatedBy")
  googleAdPlans        GoogleAdPlan[]    @relation("GoogleAdPlanCreatedBy")
  approvedGoogleAdPlans GoogleAdPlan[]   @relation("GoogleAdPlanApprovedBy")
  adVersions           AdVersion[]
  adChangeSets         AdChangeSet[] @relation("AdChangeWorkspace")
  authoredAdChanges    AdChangeSet[] @relation("AdChangeAuthor")
  adApprovalRequests   AdApprovalRequest[] @relation("AdApprovalWorkspace")
  decidedAdApprovals   AdApprovalRequest[] @relation("AdApprovalActor")
  adSyncOperations     AdSyncOperation[]
  aiOptimizationRuns   AiOptimizationRun[]
  adResearchRuns      AdResearchRun[] @relation("AdResearchRunCreatedBy")
  adResearchEvidence  AdResearchEvidence[] @relation("AdResearchEvidenceCreatedBy")
  adBackgroundJobs     AdBackgroundJob[]
  authoredMediaGenerations MediaGeneration[] @relation("MediaGenerationAuthor")
  tenantMediaGenerations   MediaGeneration[] @relation("MediaGenerationWorkspace")
  workspaceAnalyticsEvents WorkspaceAnalyticsEvent[] @relation("WorkspaceAnalyticsOwner")
  leadForms          LeadForm[]
  workflows          Workflow[]
  workspaceFiles     WorkspaceFile[] @relation("WorkspaceFileWorkspace")
  uploadedFiles      WorkspaceFile[] @relation("WorkspaceFileUploader")
  trashedFiles       WorkspaceFile[] @relation("WorkspaceFileTrashUser")
  knowledgeEntries   KnowledgeEntry[]
  seoKeywords        SeoKeyword[]
  seoCompetitors     SeoCompetitor[]
  seoResearchRuns    SeoResearchRun[]
  seoKeywordIdeas    SeoKeywordIdea[]
  seoKeywordClusters SeoKeywordCluster[]
  seoContentBriefs   SeoContentBrief[]
  projects           Project[]
  contracts          Contract[]
  passwordResetTokens PasswordResetToken[]

  @@index([workspaceOwnerId])
  @@index([activeWorkspaceId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowRunStatus {
  DRY_RUN
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model Workflow {
  id          String         @id @default(cuid())
  createdById String
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)
  trigger     String
  conditions  Json
  actions     Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]

  @@index([createdById, status])
  @@map("workflows")
}

model WorkflowRun {
  idempotencyKey String           @id
  workflowId     String
  status         WorkflowRunStatus
  triggerData    Json?
  result         Json?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime         @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("workflow_runs")
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum AccountClass {
  PLATFORM_OWNER
  PLATFORM_SUPPORT
  CLIENT_OWNER
  CLIENT_MEMBER
  TESTER
  TRIAL
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PlatformRole {
  OWNER
  SUPPORT
}

enum WorkspaceMembershipStatus {
  ACTIVE
  INVITED
  DECLINED
}

model Workspace {
  id          String        @id @default(cuid())
  name        String
  type        WorkspaceType @default(TEAM)
  ownerUserId String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner       User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships WorkspaceMembership[]
  moduleEntitlements WorkspaceModuleEntitlement[]

  @@index([ownerUserId])
  @@map("workspaces")
}

model WorkspaceModuleEntitlement {
  id          String   @id @default(cuid())
  workspaceId String
  moduleId    String
  status      String   @default("ACTIVE")
  source      String   @default("FREE")
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleId])
  @@index([workspaceId, status])
  @@map("workspace_module_entitlements")
}

model WorkspaceMembership {
  id          String                    @id @default(cuid())
  workspaceId String
  userId      String
  role        UserRole                  @default(MEMBER)
  status      WorkspaceMembershipStatus @default(ACTIVE)
  invitedById String?
  invitedAt   DateTime?
  respondedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceMembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@map("workspace_memberships")
}

model RegistrationRequest {
  id                    String                    @id @default(cuid())
  name                  String
  email                 String
  company               String?
  message               String?                   @db.Text
  passwordHash          String
  requestedRole         UserRole                  @default(MEMBER)
  status                RegistrationRequestStatus @default(PENDING_EMAIL_VERIFICATION)
  emailVerificationToken String                   @unique
  emailVerifiedAt       DateTime?
  reviewedById          String?
  targetWorkspaceOwnerId String?
  targetWorkspaceId     String?
  invitedById           String?
  reviewedAt            DateTime?
  rejectionReason       String?                   @db.Text
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  reviewedBy            User?                     @relation("RegistrationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([targetWorkspaceOwnerId, status, createdAt])
  @@index([targetWorkspaceId, status, createdAt])
  @@index([invitedById])
  @@index([email])
  @@map("registration_requests")
}

enum RegistrationRequestStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model FeedbackItem {
  id             String         @id @default(cuid())
  userId         String?
  userEmail      String?
  subject        String
  message        String         @db.Text
  pageUrl        String?
  status         FeedbackStatus @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  reviewedBy     User?          @relation("FeedbackReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@map("feedback_items")
}

enum FeedbackStatus {
  OPEN
  TRIAGED
  CLOSED
}

enum UserRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  TRIAL
  TESTER
  VIEWER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model UserPermission {
  id         String @id @default(cuid())
  userId     String
  permission String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@map("user_permissions")
}

// LEADS
model Lead {
  id              String      @id @default(cuid())
  status          LeadStatus  @default(NEW)
  pipelineStageId String?
  createdById     String
  savedById       String?
  lastEditedById  String?
  assignedToId    String?

  companyName     String
  website         String?
  phone           String?
  email           String?
  industry        String?
  employeeCount   String?

  address         String?
  city            String?
  state           String?
  country         String?
  zipCode         String?
  latitude        Float?
  longitude       Float?

  gmbPlaceId      String?
  gmbRating       Float?
  gmbReviewCount  Int?
  gmbCategories   String[]
  gmbPhotosUrl    String?

  facebookUrl     String?
  linkedinUrl     String?
  instagramUrl    String?
  twitterUrl      String?
  yelpUrl         String?
  tiktokUrl       String?
  youtubeUrl      String?

  overallScore    Float?
  scorePriority   String?
  scoreComputedAt DateTime?

  source          String?
  sourceQuery     String?

  lastContactedAt DateTime?
  lastEnrichedAt  DateTime?
  doNotContact    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdBy       User        @relation("CreatedByUser", fields: [createdById], references: [id])
  savedBy         User?       @relation("LeadSavedBy", fields: [savedById], references: [id], onDelete: SetNull)
  lastEditedBy    User?       @relation("LeadLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  assignedTo      User?       @relation("AssignedToUser", fields: [assignedToId], references: [id])
  pipelineStage   PipelineStage? @relation(fields: [pipelineStageId], references: [id])

  scoringFactors  LeadScoringFactor[]
  tags            LeadTag[]
  customFieldValues CustomFieldValue[]
  notes           Note[]
  activities      Activity[]
  emailDrafts     EmailDraft[]
  campaignLeads   CampaignLead[]
  reports         Report[]
  enrichmentData  EnrichmentData[]
  contacts        LeadContact[]
  openclawSuggestions OpenClawSuggestion[]
  leadAnalysisRuns LeadAnalysisRun[]
  bookings        Booking[]
  domains         Domain[]
  reviewRequests  ReviewRequest[]
  quotes       Quote[]
  chatSessions   ChatSession[]
  formSubmissions FormSubmission[]

  @@index([companyName])
  @@index([city, state, country])
  @@index([overallScore(sort: Desc)])
  @@index([status])
  @@index([scorePriority])
  @@index([assignedToId])
  @@index([savedById])
  @@index([lastEditedById])
  @@index([source])
  @@index([createdAt(sort: Desc)])
  @@index([createdById])
  @@index([createdById, createdAt(sort: Desc)])
  @@index([createdById, updatedAt(sort: Desc)])
  @@index([createdById, status])
  @@index([email])
  @@index([gmbPlaceId])
  @@index([createdById, gmbPlaceId])
  @@map("leads")
}

enum LeadStatus {
  NEW
  RESEARCHING
  CONTACTED
  RESPONDED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  ARCHIVED
}

enum LeadFormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LeadForm {
  id          String         @id @default(cuid())
  createdById String
  name        String
  publicKey   String         @unique @default(cuid())
  status      LeadFormStatus @default(DRAFT)
  fields      Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([createdById, status])
  @@map("lead_forms")
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  leadId      String?
  fingerprint String
  data        Json
  createdAt   DateTime @default(now())

  form        LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([formId, fingerprint])
  @@index([formId, createdAt(sort: Desc)])
  @@index([leadId])
  @@map("form_submissions")
}

model LeadContact {
  id        String  @id @default(cuid())
  leadId    String
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_contacts")
}

// SCORING
model ScoringWeight {
  id          String  @id @default(cuid())
  createdById String  @default("_global")
  factorKey   String
  label       String
  description String?
  weight      Float   @default(1.0)
  maxPoints   Float   @default(10.0)
  enabled     Boolean @default(true)
  category    String?
  sortOrder   Int     @default(0)

  factors LeadScoringFactor[]

  @@unique([createdById, factorKey])
  @@index([createdById])
  @@map("scoring_weights")
}

model LeadScoringFactor {
  id              String   @id @default(cuid())
  leadId          String
  scoringWeightId String
  rawValue        Float
  weightedValue   Float
  explanation     String?
  metadata        Json?
  computedAt      DateTime @default(now())

  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scoringWeight ScoringWeight @relation(fields: [scoringWeightId], references: [id])

  @@unique([leadId, scoringWeightId])
  @@map("lead_scoring_factors")
}

// PIPELINE
model PipelineStage {
  id        String  @id @default(cuid())
  createdById String?
  name      String
  color     String  @default("#6366f1")
  sortOrder Int     @default(0)
  isDefault Boolean @default(false)

  leads Lead[]

  @@index([createdById])
  @@unique([createdById, name])
  @@map("pipeline_stages")
}

// TAGS
model Tag {
  id          String @id @default(cuid())
  createdById String?
  name        String
  color       String @default("#6366f1")

  leads LeadTag[]

  @@index([createdById])
  @@unique([createdById, name])
  @@map("tags")
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

// CUSTOM FIELDS
model CustomField {
  id        String          @id @default(cuid())
  name      String
  key       String          @unique
  fieldType CustomFieldType @default(TEXT)
  options   String[]
  required  Boolean         @default(false)
  sortOrder Int             @default(0)

  values CustomFieldValue[]

  @@map("custom_fields")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  URL
}

model CustomFieldValue {
  id            String @id @default(cuid())
  leadId        String
  customFieldId String
  value         String

  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, customFieldId])
  @@map("custom_field_values")
}

// CAMPAIGNS (automation profiles: lead drip, review requests, …)
enum CampaignProfileType {
  LEAD_OUTREACH
  REVIEW_REQUEST
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  profileType CampaignProfileType @default(LEAD_OUTREACH) @map("profile_type")
  niche       String?
  region      String?
  targetAudience String?
  idealScore  Float?
  desiredServices String[]
  toneOfVoice String?
  goal        String?
  status      CampaignStatus @default(DRAFT)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy     User           @relation(fields: [createdById], references: [id])
  campaignLeads CampaignLead[]
  templates     EmailTemplate[]
  reports       Report[]

  @@index([createdById])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model CampaignLead {
  campaignId String
  leadId     String
  addedAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([campaignId, leadId])
  @@map("campaign_leads")
}

// EMAIL / CONTACT
enum EmailTemplateType {
  OUTREACH
  FOLLOW_UP
  PROPOSAL
  REPORT
  BOOKING
  REVIEW
  REENGAGEMENT
  CUSTOM
}

enum EmailTemplateLayout {
  modern
  minimal
  business
  proposal
  followup
}

enum EmailTemplateBodyFormat {
  TEXT
  HTML
}

enum EmailModule {
  LEADS
  CAMPAIGNS
  QUOTES
  INVOICES
  BOOKINGS
  REVIEWS
  AUTH
  INBOX
  SYSTEM
}

model EmailTemplate {
  id          String                   @id @default(cuid())
  createdById String?
  name        String
  subject     String
  body        String                   @db.Text
  bodyFormat  EmailTemplateBodyFormat  @default(TEXT)
  type        EmailTemplateType        @default(CUSTOM)
  layout      EmailTemplateLayout @default(modern)
  module      EmailModule              @default(LEADS)
  templateKey String?
  isSystem    Boolean                  @default(false)
  description String              @default("")
  ctaText     String              @default("")
  ctaUrl      String              @default("")
  campaignId  String?
  isGlobal    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  campaign  Campaign? @relation(fields: [campaignId], references: [id])
  drafts    EmailDraft[]

  @@index([createdById])
  @@index([createdById, type])
  @@index([createdById, layout])
  @@index([createdById, module])
  @@unique([createdById, name])
  @@unique([createdById, templateKey])
  @@map("email_templates")
}

model EmailDraft {
  id           String      @id @default(cuid())
  workspaceId  String
  leadId       String?
  templateId   String?
  authorId     String
  approverId   String?
  idempotencyKey String?

  toEmail      String
  subject      String
  body         String      @db.Text
  status       EmailStatus @default(DRAFT)
  type         EmailType   @default(LEAD_CONTACT)

  sequenceId   String?
  sequenceStep Int?
  scheduledFor DateTime?

  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectionNote String?

  sentAt       DateTime?
  messageId    String?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  repliedAt    DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lead     Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  template EmailTemplate? @relation(fields: [templateId], references: [id])
  author   User           @relation("DraftAuthor", fields: [authorId], references: [id])
  approver User?          @relation("DraftApprover", fields: [approverId], references: [id])
  sequence EmailSequence? @relation(fields: [sequenceId], references: [id])

  @@index([status])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([leadId])
  @@index([scheduledFor])
  @@index([sequenceId, sequenceStep])
  @@index([authorId])
  @@index([approverId])
  @@index([type])
  @@unique([workspaceId, idempotencyKey])
  @@map("email_drafts")
}

enum EmailStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  SENDING
  DELIVERY_UNKNOWN
  SENT
  FAILED
  BOUNCED
}

enum EmailType {
  LEAD_CONTACT
  QUOTE
  REPLY
  FOLLOW_UP
  REVIEW_REQUEST
  TRANSACTIONAL
}

model EmailSequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  steps       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  drafts EmailDraft[]

  @@map("email_sequences")
}

// NOTES & ACTIVITIES
model Note {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("notes")
}

model Activity {
  id        String       @id @default(cuid())
  leadId    String?
  userId    String?
  type      ActivityType
  title     String
  metadata  Json?
  createdAt DateTime     @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("activities")
}

// WORKSPACE FILES
// The storage URL is intentionally kept out of normal list responses. Files are
// served through the authenticated /api/files/:id route.
model WorkspaceFile {
  id           String   @id @default(cuid())
  createdById  String
  uploadedById String
  name         String
  storageUrl   String
  storage      String   @default("local")
  storageProvider String  @default("LOCAL")
  storageKey   String?
  contentType  String
  size         Int
  checksumSha256 String?
  relatedType  String?
  relatedId    String?
  folderId     String?
  deletedAt    DateTime?
  trashedById   String?
  driveFileId   String?
  driveWebUrl   String?
  driveEtag     String?
  driveSyncStatus String?
  lastError     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceOwner User @relation("WorkspaceFileWorkspace", fields: [createdById], references: [id], onDelete: Cascade)
  uploadedBy     User @relation("WorkspaceFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  trashedBy      User? @relation("WorkspaceFileTrashUser", fields: [trashedById], references: [id], onDelete: SetNull)

  @@index([createdById, createdAt(sort: Desc)])
  @@index([createdById, relatedType, relatedId])
  @@index([uploadedById, deletedAt, createdAt(sort: Desc)])
  @@index([createdById, folderId, deletedAt, createdAt(sort: Desc)])
  @@index([driveFileId])
  @@map("workspace_files")
}

model UserFileQuota {
  id            String   @id @default(cuid())
  userId        String
  workspaceId   String
  quotaBytes    BigInt   @default(1073741824)
  usedBytes     BigInt   @default(0)
  reservedBytes BigInt   @default(0)
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId, userId])
  @@map("user_file_quotas")
}

model FileStorageReservation {
  id             String   @id @default(cuid())
  userId         String
  workspaceId    String
  fileId         String?
  idempotencyKey String   @unique
  bytes          BigInt
  status         String   @default("RESERVED")
  expiresAt      DateTime
  committedAt    DateTime?
  releasedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId, userId, status])
  @@index([expiresAt, status])
  @@map("file_storage_reservations")
}

model FileFolder {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId, parentId, createdAt(sort: Desc)])
  @@map("file_folders")
}

enum KnowledgeEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KnowledgeEntry {
  id          String              @id @default(cuid())
  createdById String
  title       String
  slug        String
  content     String              @db.Text
  status      KnowledgeEntryStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  createdBy User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  versions  KnowledgeEntryVersion[]

  @@unique([createdById, slug])
  @@index([createdById, status, updatedAt(sort: Desc)])
  @@map("knowledge_entries")
}

model KnowledgeEntryVersion {
  id        String   @id @default(cuid())
  entryId   String
  version   Int
  title     String
  content   String   @db.Text
  createdById String
  createdAt DateTime @default(now())

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, version])
  @@index([entryId, createdAt(sort: Desc)])
  @@map("knowledge_entry_versions")
}

enum SeoKeywordStatus {
  TRACKING
  PAUSED
}

model SeoKeyword {
  id            String          @id @default(cuid())
  createdById   String
  domainId      String?
  keyword       String
  keywordKey    String
  location      String?
  language      String?
  targetUrl     String?
  currentRank   Int?
  previousRank  Int?
  status        SeoKeywordStatus @default(TRACKING)
  lastCheckedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  source        SeoKeywordSource @default(MANUAL)
  intent        SeoKeywordIntent?
  clusterId     String?

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  cluster   SeoKeywordCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@unique([createdById, keywordKey])
  @@index([createdById, status, updatedAt(sort: Desc)])
  @@index([createdById, domainId])
  @@map("seo_keywords")
}

enum SeoKeywordSource {
  MANUAL
  GOOGLE_ADS
  SEARCH_CONSOLE
  AI
}

enum SeoKeywordIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
  LOCAL
  UNKNOWN
}

enum SeoResearchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
}

enum SeoBriefStatus {
  IDEA
  IN_PROGRESS
  PUBLISHED
  STALE
}

model SeoResearchRun {
  id              String           @id @default(cuid())
  workspaceId     String
  createdById     String
  domainId        String?
  status          SeoResearchStatus @default(PENDING)
  provider        String
  language        String
  location        String
  seeds           Json
  options         Json?
  results         Json?
  attempts        Int              @default(0)
  leaseUntil      DateTime?
  idempotencyKey  String           @unique
  error           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  domain    Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  ideas     SeoKeywordIdea[]

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, domainId, createdAt(sort: Desc)])
  @@map("seo_research_runs")
}

model SeoKeywordIdea {
  id                 String          @id @default(cuid())
  workspaceId        String
  createdById        String
  researchRunId      String?
  keyword            String
  keywordKey         String
  source             SeoKeywordSource
  language           String
  location           String
  intent             SeoKeywordIntent @default(UNKNOWN)
  searchVolume       Int?
  competition        Float?
  cpcCents           Int?
  impressions        Int?
  clicks             Int?
  ctr                Float?
  averagePosition    Float?
  targetUrl          String?
  evidence           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  researchRun SeoResearchRun?  @relation(fields: [researchRunId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, keywordKey, language, location, source])
  @@index([workspaceId, source, updatedAt(sort: Desc)])
  @@index([workspaceId, intent, language, location])
  @@map("seo_keyword_ideas")
}

model SeoKeywordCluster {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  intent      SeoKeywordIntent @default(UNKNOWN)
  targetUrl   String?
  keywords    Json
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tracked  SeoKeyword[]
  briefs   SeoContentBrief[]

  @@index([workspaceId, updatedAt(sort: Desc)])
  @@map("seo_keyword_clusters")
}

model SeoContentBrief {
  id            String        @id @default(cuid())
  workspaceId   String
  createdById   String
  clusterId     String?
  domainId      String?
  status        SeoBriefStatus @default(IDEA)
  title         String
  targetUrl     String?
  brief         Json
  profileHash   String?
  profileVersion Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  cluster   SeoKeywordCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  domain    Domain?            @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, updatedAt(sort: Desc)])
  @@map("seo_content_briefs")
}

model SeoCompetitor {
  id          String   @id @default(cuid())
  createdById String
  domainId    String?
  name        String
  url         String
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, updatedAt(sort: Desc)])
  @@index([createdById, domainId])
  @@map("seo_competitors")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Project {
  id          String        @id @default(cuid())
  createdById String
  leadId      String?
  quoteId     String?
  name        String
  clientName  String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNED)
  startAt     DateTime?
  dueAt       DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, status, updatedAt(sort: Desc)])
  @@index([createdById, leadId])
  @@index([createdById, quoteId])
  @@map("projects")
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
}

model Contract {
  id             String         @id @default(cuid())
  createdById    String
  projectId      String?
  quoteId        String?
  name           String
  clientName     String
  clientEmail    String?
  content        String         @db.Text
  version        Int            @default(1)
  status         ContractStatus @default(DRAFT)
  sentAt         DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  declinedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, status, updatedAt(sort: Desc)])
  @@index([createdById, projectId])
  @@index([createdById, quoteId])
  @@map("contracts")
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  scope     String
  key       String   @unique
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([scope, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

