  LEAD_CREATED
  LEAD_UPDATED
  LEAD_STATUS_CHANGED
  LEAD_SCORED
  LEAD_ENRICHED
  LEAD_ASSIGNED
  NOTE_ADDED
  EMAIL_DRAFTED
  EMAIL_APPROVED
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_REPLIED
  CAMPAIGN_CREATED
  REPORT_GENERATED
  OPENCLAW_SUGGESTION
  SEARCH_PERFORMED
  QUOTE_CREATED
